{
	"breadcrumbs.enabled": false,
	"[django-html]": {
		"editor.defaultFormatter": "monosans.djlint"
	},
	"editor.bracketPairColorization.enabled": true,
	"editor.cursorBlinking": "expand",
	"editor.cursorStyle": "line",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.codeLensFontFamily": "Monocraft",
	"editor.detectIndentation": true,
	"editor.fontFamily": "'JetBrains Mono','Monocraft','Droid Sans Mono', 'monospace', monospace",
	"editor.fontSize": 13,
	"editor.fontLigatures": true,
	"editor.formatOnPaste": false,
	"editor.formatOnSave": true,
	"editor.glyphMargin": false,
	"editor.guides.bracketPairs": true,
	"editor.inlayHints.fontFamily": "Monocraft",
	"editor.inlineSuggest.enabled": true,
	"editor.insertSpaces": false,
	"editor.lineNumbers": "relative",
	"editor.lineHeight": 1.5,
	"editor.linkedEditing": true,
	"editor.lightbulb.enabled": "on",
	"editor.minimap.enabled": false,
	"editor.multiCursorModifier": "ctrlCmd",
	"editor.mouseWheelZoom": true,
	"editor.overviewRulerBorder": false,
	"editor.rulers": [
		79
	],
	"editor.renderLineHighlight": "gutter",
	"editor.renderWhitespace": "all",
	"editor.scrollbar.horizontal": "hidden",
	"editor.scrollbar.vertical": "hidden",
	"editor.suggestSelection": "first",
	"editor.snippetSuggestions": "bottom",
	"editor.stickyScroll.enabled": true,
	"editor.wordWrap": "on",
	"editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
	"explorer.compactFolders": false,
	"explorer.fileNesting.enabled": true,
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"telemetry.telemetryLevel": "off",
	"workbench.activityBar.location": "default",
	"workbench.colorTheme": "Pycharm Original Theme",
	"workbench.editor.labelFormat": "short",
	"workbench.editor.pinnedTabSizing": "compact",
	"workbench.editor.tabSizing": "shrink",
	"workbench.editor.enablePreview": true,
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.editor.showTabs": "multiple",
	"workbench.iconTheme": "vsc-jetbrains-icons-enhanced",
	"workbench.layoutControl.enabled": false,
	"workbench.productIconTheme": "icons-carbon",
	"workbench.startupEditor": "newUntitledFile",
	"explorer.openEditors.sortOrder": "alphabetical",
	"window.density.editorTabHeight": "compact",
	"window.menuBarVisibility": "hidden"
}